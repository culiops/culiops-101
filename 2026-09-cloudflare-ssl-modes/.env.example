# Copy to .env and `source .env` before the lab. NEVER commit .env.

# --- AWS ------------------------------------------------------------------------
# A named profile (or export standard AWS credentials another way). The credentials must be
# allowed to create an IAM role (the origin needs an SSM instance profile).
export AWS_PROFILE=
export AWS_REGION=ap-southeast-1

# --- Cloudflare -----------------------------------------------------------------
# API token scoped to your THROWAWAY zone with:
#   Zone : DNS            : Edit   (Terraform creates the proxied record)
#   Zone : Zone           : Read   (the safety guard looks the zone name up)
#   Zone : Zone Settings  : Edit   (prepare-zone.sh / cleanup.sh read + restore the SSL mode)
# It does NOT need "SSL and Certificates : Edit": every SSL-mode change and the Origin CA
# certificate are done by hand in the dashboard - that is the lesson.
export CLOUDFLARE_API_TOKEN=

# Your zone's ID (zone Overview page, right sidebar).
export CLOUDFLARE_ZONE_ID=

# SAFETY GUARD: scripts and Terraform abort unless the zone behind CLOUDFLARE_ZONE_ID has exactly
# this name, and they always refuse culiops.dev / culipulse.dev / 1cost.dev. This lab flips a
# ZONE-WIDE setting - only ever point it at a throwaway zone.
export LAB_ZONE_NAME=culilab.dev

# The hostname the lab creates (a subdomain of LAB_ZONE_NAME).
export ORIGIN_HOSTNAME=app.culilab.dev

# Terraform reads these (same values, so you set them once):
export TF_VAR_cloudflare_zone_id="${CLOUDFLARE_ZONE_ID}"
export TF_VAR_lab_zone_name="${LAB_ZONE_NAME}"
export TF_VAR_origin_hostname="${ORIGIN_HOSTNAME}"
