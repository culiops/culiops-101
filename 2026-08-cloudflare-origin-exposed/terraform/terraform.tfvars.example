# Copy to terraform.tfvars and fill in. NEVER commit terraform.tfvars.
#
# Terraform only stands up the AWS "stage" (the exposed origin). The Cloudflare side is done
# by hand in the demo, so there is NO Cloudflare token or zone id here — those live in ../.env
# and are used by the `curl` steps in the README.

# A subdomain of your THROWAWAY / sandbox Cloudflare zone. This lab intentionally exposes an
# origin — never a production zone. Terraform uses this only for the cert CN + check commands;
# you create the actual proxied A record by hand.
origin_hostname = "cf-origin.culilab.dev"

# --- REQUIRED: SSH (the Layer 2 step SSHes into the box to enable mTLS) ---
key_name         = "my-ec2-keypair"    # an existing EC2 key pair in this region
ssh_ingress_cidr = "203.0.113.10/32"   # YOUR public IP as /32 (curl ifconfig.me)

# --- Optional ---
# aws_region    = "ap-southeast-1"
# instance_type = "t3.micro"
